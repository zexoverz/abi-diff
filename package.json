{
  "name": "abi-diff",
  "version": "0.1.0",
  "description": "Find breaking changes between two contract ABIs: removed or changed functions, moved event topics, selector clashes.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zexoverz/abi-diff.git"
  },
  "keywords": [
    "abi",
    "solidity",
    "diff",
    "breaking-changes",
    "semver",
    "ethereum",
    "viem"
  ],
  "homepage": "https://github.com/zexoverz/abi-diff",
  "bin": {
    "abi-diff": "dist/cli.js"
  },
  "dependencies": {
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
